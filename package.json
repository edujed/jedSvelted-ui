{
	"name": "jedsvelted-ui",
	"version": "0.0.1",
	"description": "A collection of reusable UI components for Svelte 5 applications.",
	"author": {
		"name": "Eduardo Jedliczka",
		"email": "jed@jed.dev"
	},
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"test": "vitest --ui",
		"test:run": "vitest run",
		"dev": "vite dev",
		"build": "npm run prepack",
		"prepack": "svelte-package",
		"check": "svelte-check",
		"check:watch": "svelte-check --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"src",
		"!src/**/*.{test,spec}.*",
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts"
		},
		"./container/*": {
			"types": "./src/lib/container/*.ts",
			"svelte": "./src/lib/container/*.svelte"
		},
		"./forms/*": {
			"types": "./src/lib/forms/*.ts",
			"svelte": "./src/lib/forms/*.svelte"
		},
		"./icons/*": {
			"types": "./src/lib/icons/*.ts",
			"svelte": "./src/lib/icons/*.svelte"
		},
		"./info/*": {
			"types": "./src/lib/info/*.ts",
			"svelte": "./src/lib/info/*.svelte"
		},
		"./nav/*": {
			"types": "./src/lib/nav/*.ts",
			"svelte": "./src/lib/nav/*.svelte"
		},
		"./pages/*": {
			"types": "./src/lib/pages/*.ts",
			"svelte": "./src/lib/pages/*.svelte"
		},
		"./table/*": {
			"types": "./src/lib/table/*.ts",
			"svelte": "./src/lib/table/*.svelte"
		},
		"./tabs/*": {
			"types": "./src/lib/tabs/*.ts",
			"svelte": "./src/lib/tabs/*.svelte"
		},
		"./ui/*": {
			"types": "./src/lib/ui/*.ts",
			"svelte": "./src/lib/ui/*.svelte"
		}
	},
	"peerDependencies": {
		"bits-ui": "^2.19.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"@vitest/ui": "^3.2.7",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.7",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^3.2.7"
	},
	"keywords": [
		"svelte"
	],
	"allowScripts": {
		"svelte-preprocess@6.0.5": true,
		"esbuild@0.28.2": true
	}
}
