{
	"name": "@edujed/jedsvelted-ui",
	"version": "0.0.1",
	"description": "A collection of reusable UI components for Svelte 5 applications.",
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Eduardo Jedliczka",
		"email": "edujed@gmail.com"
	},
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"test": "vitest --ui",
		"test:run": "vitest run",
		"dev": "vite dev",
		"build": "npm run prepack",
		"prepack": "svelte-package",
		"check": "svelte-check",
		"check:watch": "svelte-check --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./container/*": {
			"types": "./dist/container/*.d.ts",
			"svelte": "./dist/container/*.svelte"
		},
		"./forms/*": {
			"types": "./dist/forms/*.d.ts",
			"svelte": "./dist/forms/*.svelte"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"svelte": "./dist/icons/*.svelte"
		},
		"./info/*": {
			"types": "./dist/info/*.d.ts",
			"svelte": "./dist/info/*.svelte"
		},
		"./nav/*": {
			"types": "./dist/nav/*.d.ts",
			"svelte": "./dist/nav/*.svelte"
		},
		"./pages/*": {
			"types": "./dist/pages/*.d.ts",
			"svelte": "./dist/pages/*.svelte"
		},
		"./table/*": {
			"types": "./dist/table/*.d.ts",
			"svelte": "./dist/table/*.svelte"
		},
		"./tabs/*": {
			"types": "./dist/tabs/*.d.ts",
			"svelte": "./dist/tabs/*.svelte"
		},
		"./theme/*": {
			"types": "./dist/theme/*.d.ts",
			"svelte": "./dist/theme/*.svelte"
		},
		"./ui/*": {
			"types": "./dist/ui/*.d.ts",
			"svelte": "./dist/ui/*.svelte"
		}
	},
	"peerDependencies": {
		"bits-ui": "^2.19.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"@vitest/ui": "^3.2.7",
		"bits-ui": "^2.19.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.7",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^3.2.7"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"bits-ui",
		"ui-components"
	],
	"allowScripts": {
		"svelte-preprocess@6.0.5": true,
		"esbuild@0.28.2": true
	}
}
