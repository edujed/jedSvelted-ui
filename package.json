{
	"name": "@edujed/jedsvelted-ui",
	"version": "0.0.1-alpha.4",
	"type": "module",
	"scripts": {
		"test": "vitest --ui",
		"test:run": "vitest run",
		"build": "npm run prepack",
		"prepack": "svelte-package",
		"dev:lib": "svelte-package --watch",
		"check": "svelte-check",
		"check:watch": "svelte-check --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"svelte": "./dist/actions/index.js"
		},
		"./container": {
			"types": "./dist/container/index.d.ts",
			"svelte": "./dist/container/index.js"
		},
		"./container/*": {
			"types": "./dist/container/*.d.ts",
			"svelte": "./dist/container/*.svelte"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"svelte": "./dist/forms/index.js"
		},
		"./forms/*": {
			"types": "./dist/forms/*.d.ts",
			"svelte": "./dist/forms/*.svelte"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"svelte": "./dist/icons/*.svelte"
		},
		"./info": {
			"types": "./dist/info/index.d.ts",
			"svelte": "./dist/info/index.js"
		},
		"./info/*": {
			"types": "./dist/info/*.d.ts",
			"svelte": "./dist/info/*.svelte"
		},
		"./nav": {
			"types": "./dist/nav/index.d.ts",
			"svelte": "./dist/nav/index.js"
		},
		"./nav/*": {
			"types": "./dist/nav/*.d.ts",
			"svelte": "./dist/nav/*.svelte"
		},
		"./pages": {
			"types": "./dist/pages/index.d.ts",
			"svelte": "./dist/pages/index.js"
		},
		"./pages/*": {
			"types": "./dist/pages/*.d.ts",
			"svelte": "./dist/pages/*.svelte"
		},
		"./router": {
			"types": "./dist/router/index.d.ts",
			"svelte": "./dist/router/index.js"
		},
		"./table": {
			"types": "./dist/table/index.d.ts",
			"svelte": "./dist/table/index.js"
		},
		"./table/*": {
			"types": "./dist/table/*.d.ts",
			"svelte": "./dist/table/*.svelte"
		},
		"./tabs": {
			"types": "./dist/tabs/index.d.ts",
			"svelte": "./dist/tabs/index.js"
		},
		"./tabs/*": {
			"types": "./dist/tabs/*.d.ts",
			"svelte": "./dist/tabs/*.svelte"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"svelte": "./dist/theme/index.js"
		},
		"./theme/*": {
			"types": "./dist/theme/*.d.ts",
			"svelte": "./dist/theme/*.svelte",
			"default": "./dist/theme/*"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js"
		},
		"./ui/*": {
			"types": "./dist/ui/*.d.ts",
			"svelte": "./dist/ui/*.svelte"
		}
	},
	"peerDependencies": {
		"bits-ui": "^2.19.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"@vitest/ui": "^3.2.7",
		"bits-ui": "^2.19.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.7",
		"jsdom": "^29.1.1",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^3.2.7"
	}
}
